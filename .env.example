NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# PostgreSQL connection used by the API.
DATABASE_URL=postgresql://handcraft:change-me@localhost:55432/handcraft

SESSION_SECRET=replace-with-at-least-32-random-characters
# Sliding session: SESSION_IDLE_DAYS is renewed by activity (and by refresh);
# SESSION_ABSOLUTE_DAYS is a hard cap that forces re-login regardless of activity.
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Seconds during which a token rotated by a concurrent refresh is still tolerated.
SESSION_ROTATION_GRACE_SECONDS=30
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
TZ=Asia/Shanghai
